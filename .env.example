# EmailJS — https://dashboard.emailjs.com
# Service ID (Email Services) · Template ID (Email Templates) · Public Key (Account > General > API Keys)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# n8n — webhook del onboarding de clientes (SOLO servidor, sin prefijo NEXT_PUBLIC)
# Producción: https://n8n-nodus-automatizations-v1-n8n.tku5sp.easypanel.host/webhook/onboarding-submit
N8N_ONBOARDING_WEBHOOK_URL=https://n8n-nodus-automatizations-v1-n8n.tku5sp.easypanel.host/webhook/onboarding-submit
# Secreto del Header Auth (cabecera X-Nodus-Key). Debe coincidir con la credencial del nodo webhook en n8n.
# Generar con: openssl rand -base64 32
N8N_ONBOARDING_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
